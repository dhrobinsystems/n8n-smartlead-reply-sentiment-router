# =============================================================================
# n8n-smartlead-reply-sentiment-router - environment configuration template
# -----------------------------------------------------------------------------
# Set these on your n8n host (docker-compose `environment:`, systemd
# EnvironmentFile, or your platform's secret manager). NEVER commit a real .env.
#
# API tokens for HubSpot, Slack, Twilio and your LLM provider do NOT go here:
# they live in n8n Credentials (see README > Setup).
#
# Required n8n host settings for this workflow:
#   N8N_BLOCK_ENV_ACCESS_IN_NODE=false   # Code nodes read the variables below
#   NODE_FUNCTION_ALLOW_BUILTIN=crypto   # only needed for SMARTLEAD_WEBHOOK_SECRET
#
# ⚠️ Disclaimer & Liability Limitation: use at your own risk. The author and
# dhRobin Systems assume no responsibility or liability for any damages
# resulting from the use, misuse, or deployment of these scripts.
# See DISCLAIMER.md.
# =============================================================================

# --- Safety -------------------------------------------------------------------
# true (default): classify and post a dry-run preview to SLACK_REVIEW_CHANNEL only.
# No HubSpot writes, owner DMs or SMS. Only false/0/no/off enable live mode.
SANDBOX_MODE=true

# --- Webhook security ---------------------------------------------------------
# Random string, at least 24 characters (e.g. `openssl rand -hex 24`).
# Required in live mode. Send it as ?token=... (Smartlead) or as an
# X-Webhook-Token header (Instantly custom header).
WEBHOOK_SHARED_TOKEN=
# Optional: Smartlead webhook signing secret. When set, X-Smartlead-Signature
# (HMAC-SHA256 of the raw body) is verified as well.
SMARTLEAD_WEBHOOK_SECRET=
# Which platforms to accept: smartlead, instantly
ACCEPTED_PLATFORMS=smartlead,instantly
# Duplicate-delivery window in hours (retries within this window are ignored).
DEDUPE_TTL_HOURS=72

# --- LLM classification ---------------------------------------------------------
# none (rules only) | openai | anthropic
LLM_PROVIDER=none
# Model name for the chosen provider (required unless LLM_PROVIDER=none).
LLM_MODEL=
LLM_MAX_TOKENS=300
# Below this confidence the reply is flagged for human review (0-1).
LLM_MIN_CONFIDENCE=0.6
# Send (redacted) reply text to the LLM while SANDBOX_MODE=true.
LLM_IN_SANDBOX=false

# --- HubSpot ---------------------------------------------------------------------
# Optional: your portal ID, used to build contact links in Slack.
HUBSPOT_PORTAL_ID=
# Optional JSON overriding category -> hs_lead_status internal values.
# Defaults: {"positive":"IN_PROGRESS","neutral":"CONNECTED","objection":"BAD_TIMING","out_of_office":null,"unsubscribe":"UNQUALIFIED"}
HUBSPOT_LEAD_STATUS_MAP=
# Write last_reply_sentiment / last_reply_sentiment_confidence / last_reply_received_at
# (create these custom contact properties first, see README).
HUBSPOT_WRITE_SENTIMENT_PROPERTIES=true
# Optional: internal name of a custom single-checkbox contact property that is
# set to true on unsubscribe requests (e.g. outbound_do_not_contact).
HUBSPOT_DNC_PROPERTY=
# Characters of the reply stored in the HubSpot timeline note (0 = none).
NOTE_REPLY_EXCERPT_CHARS=500

# --- Routing -------------------------------------------------------------------------
# Positive replies at or above this confidence are routed as hot leads.
HOT_LEAD_MIN_CONFIDENCE=0.75
# Fallback channel for hot leads when the owner cannot be matched in Slack.
SLACK_HOT_LEADS_CHANNEL=#hot-leads
# Internal channel for sandbox previews, unsubscribes, unmatched and low-confidence replies.
SLACK_REVIEW_CHANNEL=#reply-review
# DM the HubSpot contact owner (matched by email via users.lookupByEmail).
SLACK_DM_OWNERS=true

# --- SMS (optional, Twilio) ----------------------------------------------------------
SMS_ENABLED=false
# Your Twilio Account SID (the auth token goes in the n8n Basic Auth credential).
TWILIO_ACCOUNT_SID=
# Twilio sending number in E.164 format.
TWILIO_FROM_NUMBER=
# JSON map of HubSpot owner ID -> owner mobile in E.164. Keep real numbers out of git.
# Example format: {"<hubspotOwnerId>":"+1XXXXXXXXXX"}
OWNER_SMS_MAP=
